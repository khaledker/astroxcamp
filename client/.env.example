# Base URL of the API. Leave empty in development (Vite proxies /api to localhost:4000).
# In production on Vercel, set this to the Render service URL, e.g. https://astroxcamp-api.onrender.com
VITE_API_URL=

# Optional ISO-8601 override for the event start.
# Defaults to 2026-12-25T09:00:00+01:00 (25 December 2026, 09:00 Algiers time).
VITE_EVENT_DATETIME=
