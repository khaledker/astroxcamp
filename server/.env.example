# Server configuration — copy to server/.env and fill in real values.
NODE_ENV=development
PORT=4000

# Comma-separated CORS allowlist (your frontend origins).
CORS_ORIGIN=http://localhost:5173

# Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret

# Admin credentials. Generate the hash with:
#   npm run hash -w server -- "your-strong-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-real-bcrypt-hash

# SQLite file. Relative paths are resolved from server/.
DATABASE_PATH=./data/astrocamp.db

# Session lifetime in hours.
SESSION_TTL_HOURS=8

# Optional: lax (default in development), strict, or none (required when the
# client is on a different site, e.g. Vercel + Render; forces Secure cookies).
# COOKIE_SAMESITE=lax
